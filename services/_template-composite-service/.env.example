FLASK_APP=app
FLASK_DEBUG=true
PORT=5000

# One base-URL var per atomic (or Forum) this composite calls. Composites
# hold no database of their own, so there's no DATABASE_URL here.
EXAMPLE_ATOMIC_SERVICE_URL=http://localhost:5001
FORUM_SERVICE_URL=http://localhost:5010

# Broker connection, if this composite publishes notifications.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
