# PATCH /events/<id>/safety-status to the Safety Check workflow. Leave unset
# (or delete this line) for local/dev — the endpoint then behaves as it did
# before SCRUM-150, with no lock.
INTERNAL_SERVICE_TOKEN=change-me-dev-only

