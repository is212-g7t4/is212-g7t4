# Copy the root .env DATABASE_URL into services/venue-availability-service/.env.
# Keep the real password in .env only; never in frontend VITE_ variables.
DATABASE_URL=postgresql://postgres.gjrbkvljlvroghwvhjtc:<DB-PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
FRONTEND_ORIGIN=http://localhost:5174
INTERNAL_SERVICE_TOKEN=
VENUE_BOOKING_LEGACY_SCHEMA=false
# DEV user-switcher simulation only, never real authentication. Exact opt-in: true
CALENDAR_DEV_MODE=false

# SCRUM-170: spoofable development headers only, NOT production authentication.
# Enable explicitly on BOTH venue services; never expose enabled services publicly.
VENUE_CLOSURE_DEV_MODE=false
# SCRUM-171: provision a private random signing key (at least 32 UTF-8 bytes)
# on the atomic service only. No fallback; preview/save return 503 when unset.
# Share the SAME key across atomic replicas; rotation invalidates previews.
# Never expose it via VITE_ or commit a real key. Preview tokens expire in 15 min.
CLOSURE_CONFIRMATION_KEY=
