FLASK_APP=app
FLASK_DEBUG=true
PORT=5007

# Downstream service URLs. These are Docker Compose service-name hostnames
# (for `docker compose up` / `npm run dev`) since containers can't reach
# each other via localhost. Running this service directly on the host
# instead (`uv run flask run`, outside Docker) needs localhost URLs instead:
# EVENT_SERVICE_URL=http://localhost:5003
# VENUE_SERVICE_URL=http://localhost:5006
EVENT_SERVICE_URL=http://event-service:5000
VENUE_SERVICE_URL=http://venue-service:5000
