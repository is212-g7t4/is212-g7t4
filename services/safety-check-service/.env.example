FLASK_APP=app
FLASK_DEBUG=true
PORT=5012

# Downstream service URLs. These are Docker Compose service-name hostnames
# (for `docker compose up` / `npm run dev`) since containers can't reach
# each other via localhost. Running this service directly on the host
# instead (`uv run flask run`, outside Docker) needs localhost URLs:
# EVENT_SERVICE_URL=http://localhost:5003
# VENUE_AVAILABILITY_SERVICE_URL=http://localhost:5008
# EQUIPMENT_REQUEST_SERVICE_URL=http://localhost:5011
# SAFETY_CHECK_RECORD_SERVICE_URL=http://localhost:5013
EVENT_SERVICE_URL=http://event-service:5000
VENUE_AVAILABILITY_SERVICE_URL=http://venue-availability-service:5000
EQUIPMENT_REQUEST_SERVICE_URL=http://equipment-request-service:5000
SAFETY_CHECK_RECORD_SERVICE_URL=http://safety-check-record-service:5000

# Composites hold no database of their own, so there's no DATABASE_URL here.

# Must match the port Vite actually used (vite.config.ts pins 5174).
FRONTEND_ORIGIN=http://localhost:5174
