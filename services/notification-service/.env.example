# OPTIONAL: only for running this service/consumer directly outside Docker.
# Docker Compose uses the repository ROOT .env; do not copy this file for Compose.
# Replace the database example with an approved connection. No DB is created here.
DATABASE_URL=postgresql://notification:change-me@localhost:5432/notification
NOTIFICATION_DEV_MODE=false
FRONTEND_ORIGIN=http://localhost:5174
# Matches the unmodified local Compose broker; use its actual password if changed.
RABBITMQ_URL=amqp://notification:local-development-only@localhost:5672/%2F
