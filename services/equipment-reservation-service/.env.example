FLASK_APP=app
FLASK_DEBUG=true
PORT=5000
FRONTEND_ORIGIN=http://localhost:5174

# One base-URL var per atomic this composite calls. Composites hold no
# database of their own, so there's no DATABASE_URL here. Inside docker
# compose these are overridden with the service hostnames.
EQUIPMENT_REQUEST_SERVICE_URL=http://localhost:5011
EVENT_SERVICE_URL=http://localhost:5003
EQUIPMENT_SERVICE_URL=http://localhost:5002
SAFETY_CHECK_RECORD_SERVICE_URL=http://localhost:5013
USER_SERVICE_URL=http://localhost:5001
# Must match Event/Equipment Request Service. Set locally; never commit a real token.
INTERNAL_SERVICE_TOKEN=
# Dispatcher only. Compose injects its RabbitMQ URL; set one locally to run the worker.
RABBITMQ_URL=
