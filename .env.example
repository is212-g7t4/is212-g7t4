# Docker Compose: copy this file to the REPOSITORY ROOT .env and configure it.
# Notification API/consumer need no services/notification-service/.env in Compose.
# Other services retain their existing service .env/database configuration.
# Never commit real .env files. Fill in <DB-PASSWORD> using approved credentials.

DATABASE_URL=postgresql://postgres.gjrbkvljlvroghwvhjtc:HN?+q247nC2HAiD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://gjrbkvljlvroghwvhjtc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_boCWUcpnSv-SxJWP8EPD2g_iFFtLGyK

# Required for Compose: one private token, supplied to all participating services.
# Generate once per local stack; do not commit or share its value in chat.
# Example generator: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this example value before running services. Empty/unset fails validation.
INTERNAL_SERVICE_TOKEN=replace-with-a-private-random-token

# Notification database defaults to DATABASE_URL above. Set this ONLY when the
# notification owner uses a different database. Other service DBs are unchanged.
# NOTIFICATION_DATABASE_URL=postgresql://user:password@host:5432/notification

# Local development identity only; NOT production authentication.
# Set these to true in your private root .env for the local feature/demo UI.
NOTIFICATION_DEV_MODE=false
VENUE_CLOSURE_DEV_MODE=false
CALENDAR_DEV_MODE=false
COMPOSE_FRONTEND_ORIGIN=http://localhost:5174

# Real-stack journeys only (`npm run test:journeys`). Set the shared seeded
# Supabase users' password in your private root .env; never commit it.
E2E_PASSWORD=
# Optional per-role overrides when the seeded accounts use different passwords.
# E2E_PASSWORD_LEAD=
# E2E_PASSWORD_COORDINATOR=
# E2E_PASSWORD_ORGANISER=
# E2E_PASSWORD_TECH_SUPPORT=
# E2E_PASSWORD_VENUE_STAFF=
# E2E_PASSWORD_SAFETY_OFFICER=

# Local RabbitMQ defaults match Compose. Compose builds client URLs automatically.
# For custom values, use URL-safe credentials (e.g. alphanumeric/base64url) because
# they are embedded in AMQP URLs. Do not change an initialized broker's password
# merely by editing this file: the persisted account must match too.
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=local-development-only
