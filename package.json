{
  "name": "is212-g7t4",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend/event-management-ui run dev",
    "dev:backend": "docker compose up --build --remove-orphans",
    "test:journeys": "playwright test -c e2e/journeys",
    "test:journeys:isolated": "node e2e/isolated/run.mjs",
    "codegen": "playwright codegen http://localhost:5174",
    "journey:fixtures": "tsx e2e/journeys/J5/J5b-equipment-over-allocation/fixtures.ts",
    "journey:fixtures:clean": "tsx e2e/journeys/J5/J5b-equipment-over-allocation/fixtures.ts clean",
    "test:backend": "for d in services/*/; do (cd \"$d\" && uv run pytest) || exit 1; done",
    "stop": "docker compose down --remove-orphans && (lsof -ti :5174 | xargs kill -9 2>/dev/null; true)"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  }
}
