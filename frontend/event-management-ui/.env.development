VITE_VENUE_SERVICE_URL=http://localhost:5006
VITE_VENUE_BOOKING_SERVICE_URL=http://localhost:5007
VITE_VENUE_AVAILABILITY_SERVICE_URL=http://localhost:5008
VITE_ATTENDEE_REGISTRATION_SERVICE_URL=http://localhost:5009
VITE_EQUIPMENT_RESERVATION_SERVICE_URL=http://localhost:5010
VITE_EQUIPMENT_REQUEST_SERVICE_URL=http://localhost:5011
VITE_SAFETY_CHECK_SERVICE_URL=http://localhost:5012
VITE_SAFETY_CHECK_RECORD_SERVICE_URL=http://localhost:5013
