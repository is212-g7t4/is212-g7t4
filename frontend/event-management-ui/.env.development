# Public endpoints for the local Compose stack; never put credentials in VITE_*.
# Vite precedence (highest first): process environment, .env.development.local,
# this file, .env.local, .env. Production mode does not load this file.
VITE_USER_SERVICE_URL=http://localhost:5001
VITE_EQUIPMENT_SERVICE_URL=http://localhost:5002
VITE_EVENT_SERVICE_URL=http://localhost:5003
